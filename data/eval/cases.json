    {
      "id": "H1", "category": "multi_turn",
      "conversation": ["What is the refund policy?"],
      "query": "What about if I bought it 20 days ago?",
      "expected": {
        "state": "conflicting_evidence", "routing": "escalate",
        "conflict_topics": ["refund_window"],
        "prepared_contains": ["refund", "20 days"]
