    {
      "id": "H4", "category": "multi_turn",
      "conversation": ["I want to cancel."],
      "query": "Do it now.",
      "expected": {
        "state": "clarification_required", "routing": "clarify",
        "prepared_contains": ["cancel"]
      },
      "note": "Context must not invent what 'it' means; clarification is preserved."
    }
