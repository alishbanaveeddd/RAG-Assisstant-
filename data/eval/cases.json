        "state": "conflicting_evidence", "routing": "escalate",
        "escalation_required": true,
        "conflict_topics": ["refund_window"],
        "required_evidence_ids": ["FAQ-02"]
      }
    },
    {
      "id": "B2", "category": "conflict",
      "query": "How long do I have to request a refund?",
      "expected": {
        "state": "conflicting_evidence", "routing": "escalate",
        "escalation_required": true,
        "conflict_topics": ["refund_window"],
        "required_evidence_ids": ["FAQ-02"]
      }
    },
    {
