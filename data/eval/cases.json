        "state": "answerable", "routing": "generate",
        "required_evidence_ids": ["FAQ-05"]
      }
    },
    {
      "id": "A2", "category": "answerable",
      "query": "How do I contact LearnForge support?",
      "expected": { "state": "answerable", "routing": "generate" }
